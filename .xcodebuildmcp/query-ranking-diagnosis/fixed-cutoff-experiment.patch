+    func testWeakPhotoClusterDoesNotLowerAcceptanceThreshold() throws {
+        let query = "pulse heart centre"
+        let photos: [FixturePhoto] = [0.097, 0.092, 0.089, 0.060].enumerated().map { index, score in
+            .init(id: "weak-\(index)", localIdentifier: "weak-\(index)", date: nil,
+                  embedding: float16Vector(first: Float(score)))
+        }
+        for residentLimit in [1, photos.count] {
+            let engine = SearchEngine(
+                textEncoder: FakeTextEncoder([query: floatVector(first: 1)]),
+                database: SearchFixtureDatabase(photos: photos), residentMediaLimit: residentLimit
+            )
+            try engine.loadIndex()
+            let response = try engine.hybridSearch(hints: hints(text: query), featurePolicy: .pro)
+            XCTAssertTrue(response.results.isEmpty, "Weak clusters must remain near misses, including across pages")
+            XCTAssertEqual(response.fallbackResults.map(\.id), photos.map(\.id))
+        }
+    }
+
